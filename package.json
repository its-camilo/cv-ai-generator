{
  "name": "cv-ai-generator",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "verify:gemini": "node scripts/verify-gemini.mjs",
    "secrets:gemini": "bash scripts/set-gemini-secrets.sh",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:layout": "vitest run src/app/core/utils/cv-page-tune.spec.ts",
